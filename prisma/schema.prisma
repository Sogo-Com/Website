generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  userAuthToken String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  roleId        Int
  role          Roles    @relation(fields: [roleId], references: [id])
}

model Roles {
  id   Int    @id @default(autoincrement())
  name String @unique
  User User[]
}

model Contact {
  id        String   @id @default(uuid())
  email     String
  nom       String
  prenom    String
  telephone String
  societe   String
  message   String   @default("")
  createdAt DateTime @default(now())
}

model Actualite {
  id                String   @id @default(uuid())
  titre             String
  photo             String   @default("")
  redacteur         String
  tempsLecture      String
  descriptionCourte String   @default("Aucune description")
  contenu           String
  createdAt         DateTime @default(now())
}

model Projet {
  id                String   @id @default(uuid())
  titre             String
  typeProjet        String   @default("")
  photo             String   @default("")
  photoLogo         String   @default("")
  descriptionCourte String   @default("")
  contenu           String
  createdAt         DateTime @default(now())
}

model Client {
  id          String   @id @default(uuid())
  nom         String
  typeClient  String   @default("")
  typeDomaine String   @default("")
  createdAt   DateTime @default(now())
}

model Collaborateur {
  id                String   @id @default(uuid())
  prenom            String
  descriptionCourte String
  description       String   @default("")
  photoInactive     String   @default("")
  photoActive       String   @default("")
  rang              Int      @default(1)
  createdAt         DateTime @default(now())
}

model PointHistoire {
  id          String @id @default(uuid())
  titre       String
  description String
  date        String
}

model PageAgence {
  id                String @id @default(uuid())
  titre             String @default("")
  photo             String @default("")
  citation          String @default("")
  valeurDescription String @default("")
}

model Valeur {
  id          String @id @default(uuid())
  titre       String @default("")
  photo       String @default("")
  description String @default("")
}

